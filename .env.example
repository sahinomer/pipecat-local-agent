# BCP-47 language code used by the agent, STT, TTS, and prompts.
AGENT_LANGUAGE=en

# Local service configuration.
WHISPER_MODEL_SIZE=small
LLM_SERVICE=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=ollama

# vLLM configuration. Replace LLM_MODEL with the model name exposed by your
# vLLM server.
# LLM_SERVICE=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=vllm

# XTTS configuration (default).
TTS_MODEL=xtts
TTS_BASE_URL=http://localhost:8000
TTS_VOICE=Claribel Dervla

# Chatterbox configuration. Comment out the XTTS block above and uncomment
# these values to use Chatterbox.
# TTS_MODEL=chatterbox
# TTS_BASE_URL=http://localhost:8004
# TTS_VOICE=Emily.wav

# Local Prometheus metrics. Keep METRICS_URL on loopback unless a containerized
# Prometheus needs to scrape the host; Docker Desktop users should bind it to
# 0.0.0.0 while the observability stack is running.
OBSERVABILITY_ENABLED=true
METRICS_URL=http://127.0.0.1:8001
GPU_METRICS_ENABLED=true
LOKI_URL=http://127.0.0.1:3100
LOG_LEVEL=INFO
